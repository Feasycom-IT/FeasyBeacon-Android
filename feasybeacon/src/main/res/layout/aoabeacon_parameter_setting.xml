<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/title_background"
        android:orientation="vertical">

        <!-- CTE Info -->
        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/aoa_cte_info_label"
                style="@style/setting_parameter_left_text"
                android:text="CTE Info:" />

            <EditText
                android:id="@+id/aoa_cte_info"
                style="@style/iBeaconEdit"
                android:digits="0123456789abcdefABCDEF"
                />

        </LinearLayout>

        <!-- Beacon ID (4 bytes hex) -->
        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/aoa_beacon_id_label"
                style="@style/setting_parameter_left_text"
                android:text="Beacon ID:" />

            <EditText
                android:id="@+id/aoa_beacon_id"
                style="@style/iBeaconEdit"
                android:digits="0123456789abcdefABCDEF"
                />

        </LinearLayout>

        <!-- Beacon Type -->
        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/aoa_beacon_type_label"
                style="@style/setting_parameter_left_text"
                android:text="Beacon Type:" />

            <EditText
                android:id="@+id/aoa_beacon_type"
                style="@style/iBeaconEdit"
                android:digits="0123456789abcdefABCDEF"
                />

        </LinearLayout>

        <!-- Enable Switch -->
        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Enable:"
                android:textColor="@color/about_title"
                android:textSize="14sp" />

            <com.feasycom.feasybeacon.ui.view.SwitchButton
                android:id="@+id/beacon_enable"
                android:layout_width="54dp"
                android:layout_height="30dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

    </LinearLayout>

</merge>