<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/title_background"
        android:orientation="vertical">

        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/condition_eddystone_urlLabel"
                style="@style/setting_parameter_left_text"
                android:text="URL: " />

            <EditText
                android:id="@+id/condition_eddystone_url"
                style="@style/iBeaconEdit"
                android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ:/." />

        </LinearLayout>

        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/condition_eddystone_url_rssi_label"
                style="@style/setting_parameter_left_text"
                android:text="RSSI at 0m: " />

            <EditText
                android:id="@+id/condition_eddystone_url_rssi"
                style="@style/iBeaconEdit"
                android:digits="0123456789-" />

        </LinearLayout>

        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Enable:"
                android:textColor="@color/about_title"
                android:textSize="14sp" />

            <com.feasycom.feasybeacon.ui.view.SwitchButton
                android:id="@+id/condition_eddystone_url_beacon_enable"
                android:layout_width="54dp"
                android:layout_height="30dp" />

        </LinearLayout>

        <LinearLayout
            style="@style/iBeaconEditLL"
            android:layout_marginTop="1dp">

            <TextView
                style="@style/setting_parameter_left_text"
                android:layout_gravity="center_vertical"
                android:text="Sensor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/condition_eddystone_url_sensor_type"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overlapAnchor="false"
                    android:padding="0dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/iBeaconEditLL"
            android:layout_marginTop="1dp">

            <TextView
                style="@style/setting_parameter_left_text"
                android:layout_gravity="center_vertical"
                android:text="Action" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/condition_eddystone_url_action_type"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overlapAnchor="false"
                    android:padding="0dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/condition_eddystone_url_interval_label"
                style="@style/setting_parameter_left_text"
                android:text="Interval(ms) " />

            <EditText
                android:id="@+id/condition_eddystone_url_interval"
                style="@style/iBeaconEdit"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout style="@style/iBeaconEditLL">

            <TextView
                android:id="@+id/condition_eddystone_url_timeout_label"
                style="@style/setting_parameter_left_text"
                android:text="Timeout(ms) " />

            <EditText
                android:id="@+id/condition_eddystone_url_timeout"
                style="@style/iBeaconEdit"
                android:inputType="number" />

        </LinearLayout>

    </LinearLayout>

</merge>
